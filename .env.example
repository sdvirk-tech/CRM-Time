# Скопируйте в .env и поправьте при необходимости.
# Compose подхватывает этот файл для сервиса web.

DEPLOY_MODE=saas
APP_URL=http://localhost:3000
# Для живого Telegram нужен HTTPS. Если задан — сниппеты и webhook берут его.
PUBLIC_URL=
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Модели: ключ в env = слот доступен. Без ключа слот серый, приложение живёт.
# Не задавайте ключи — для parse/draft есть тестовый провайдер mock.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODELS=jev-lite,jev-pro
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODELS=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=gpt-4o-mini

# Курс ЦБ РФ (USD/CNY/EUR). Пусто — XML с cbr.ru, кэш на сутки.
CBR_XML_URL=

# Опциональный IMAP для почтового канала. Нет переменных — только HTTP ingest.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_CHANNEL_KEY=
