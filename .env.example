# Скопируйте в .env и поправьте при необходимости.
# Compose подхватывает этот файл для сервиса web.

DEPLOY_MODE=saas
APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Модели: ключ в env = слот доступен. Без ключа слот серый, приложение живёт.
# Не задавайте ключи — для parse/draft есть тестовый провайдер mock.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODELS=jev-lite,jev-pro
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODELS=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=gpt-4o-mini
