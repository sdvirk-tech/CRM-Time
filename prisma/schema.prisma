generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  name           String
  loginFailCount Int               @default(0) @map("login_fail_count")
  lockedUntil    DateTime?         @map("locked_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  memberships  WorkspaceMember[]
  assignedLeads Lead[]           @relation("LeadAssignee")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  @@map("users")
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  tradeDescription String            @default("") @map("trade_description")
  defaultModel     String?           @map("default_model")
  greeting         String            @default("Здравствуйте! Напишите задачу или попросите менеджера.")
  salesPrompt      String            @default("") @map("sales_prompt")
  slaMinutes       Int               @default(15) @map("sla_minutes")
  routingMode      String            @default("pool") @map("routing_mode")
  roundRobinAt     Int               @default(0) @map("round_robin_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  members          WorkspaceMember[]
  flows            Flow[]
  blocks           FlowBlock[]
  aiProcesses      AiProcess[]
  modelBindings    ModelBinding[]
  channels         Channel[]
  contacts         Contact[]
  contactChannels  ContactChannel[]
  conversations    Conversation[]
  messages         Message[]
  leads            Lead[]
  customFields     CustomField[]
  fieldValues      FieldValue[]
  invites          Invite[]
  knowledge        KnowledgeArticle[]
  knowledgeTopics  KnowledgeTopic[]
  channelEvents    ChannelEvent[]
  activityEvents   ActivityEvent[]
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Flow {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String      @default("Основная цепочка")
  published   Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks      FlowBlock[]
  @@index([workspaceId])
  @@map("flows")
}

model FlowBlock {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  flowId      String     @map("flow_id")
  type        String
  position    Int
  label       String
  config      Json       @default("{}")
  lastError   String?    @map("last_error")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow        Flow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([flowId, position])
  @@map("flow_blocks")
}

model AiProcess {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  type        String
  name        String
  prompt      String         @default("")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  binding     ModelBinding?
  @@index([workspaceId])
  @@map("ai_processes")
}

model ModelBinding {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  aiProcessId String     @unique @map("ai_process_id")
  provider    String
  model       String
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process     AiProcess  @relation(fields: [aiProcessId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@map("model_bindings")
}

model Channel {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  type        String
  name        String
  publicKey   String            @unique @map("public_key")
  secretsEnc  String?           @map("secrets_enc")
  config      Json              @default("{}")
  enabled     Boolean           @default(true)
  topicId     String?           @map("topic_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic       KnowledgeTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  contactChannels ContactChannel[]
  conversations Conversation[]
  events        ChannelEvent[]
  @@index([workspaceId])
  @@map("channels")
}

model Contact {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  name        String
  phone       String?
  comment     String           @default("")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels    ContactChannel[]
  conversations Conversation[]
  leads       Lead[]
  fieldValues FieldValue[]
  @@index([workspaceId])
  @@index([workspaceId, phone])
  @@map("contacts")
}

model ContactChannel {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  contactId   String    @map("contact_id")
  channelId   String    @map("channel_id")
  type        String
  externalId  String    @map("external_id")
  username    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, type, externalId])
  @@index([workspaceId])
  @@map("contact_channels")
}

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  contactId   String    @map("contact_id")
  channelId   String    @map("channel_id")
  status      String    @default("ai")
  assigneeId  String?   @map("assignee_id")
  unread      Boolean   @default(true)
  urgent      Boolean   @default(false)
  urgentReason String?  @map("urgent_reason")
  aiError     String?   @map("ai_error")
  pingDraftedAt DateTime? @map("ping_drafted_at")
  pingSentAt    DateTime? @map("ping_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    Message[]
  leads       Lead[]
  activity    ActivityEvent[]
  @@index([workspaceId])
  @@index([workspaceId, unread])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  workspaceId    String       @map("workspace_id")
  conversationId String       @map("conversation_id")
  direction      String
  body           String
  aiError        String?      @map("ai_error")
  sentAt         DateTime?    @map("sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Lead {
  id             String       @id @default(cuid())
  workspaceId    String       @map("workspace_id")
  contactId      String       @map("contact_id")
  conversationId String?      @map("conversation_id")
  status         String       @default("new")
  source         String
  assigneeId     String?      @map("assignee_id")
  urgent         Boolean      @default(false)
  comment        String       @default("")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  fieldValues    FieldValue[]
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("leads")
}

model CustomField {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  name        String
  key         String
  fieldType   String       @map("field_type")
  required    Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values      FieldValue[]
  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_fields")
}

model FieldValue {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  fieldId     String      @map("field_id")
  contactId   String?     @map("contact_id")
  leadId      String?     @map("lead_id")
  value       String
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  field       CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([contactId])
  @@index([leadId])
  @@map("field_values")
}

model KnowledgeTopic {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  name        String
  enabled     Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles    KnowledgeArticle[]
  channels    Channel[]
  @@index([workspaceId])
  @@map("knowledge_topics")
}

model KnowledgeArticle {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  topicId     String?          @map("topic_id")
  title       String
  body        String
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic       KnowledgeTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
  @@index([topicId])
  @@map("knowledge_articles")
}

model ActivityEvent {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  conversationId String?       @map("conversation_id")
  channelId      String?       @map("channel_id")
  actor          String
  event          String
  message        String
  createdAt      DateTime      @default(now()) @map("created_at")
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

model ChannelEvent {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  channelId   String    @map("channel_id")
  eventKey    String    @map("event_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@unique([channelId, eventKey])
  @@index([workspaceId])
  @@map("channel_events")
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String?
  token       String    @unique
  role        String    @default("manager")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  acceptedAt  DateTime? @map("accepted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@map("invites")
}
